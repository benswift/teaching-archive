---
import BaseLayout from "astro-theme-anu/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
}

const links = [
  { text: "Year 11", href: `${import.meta.env.BASE_URL}labs-year-11/` },
  { text: "Year 12", href: `${import.meta.env.BASE_URL}labs-year-12/` },
  { text: "Resources", href: `${import.meta.env.BASE_URL}resources/` },
  { text: "People", href: `${import.meta.env.BASE_URL}people/` },
];

const { title, description } = Astro.props;
---

<BaseLayout
  title={`${title} — EXTN1019`}
  description={description}
  name="EXTN1019"
  links={links}
>
  <slot />
</BaseLayout>
