---
import BaseLayout from "astro-theme-anu/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
}

const links = [
  { text: "Labs", href: `${import.meta.env.BASE_URL}labs/` },
  { text: "Assessments", href: `${import.meta.env.BASE_URL}assessments/` },
  { text: "Resources", href: `${import.meta.env.BASE_URL}resources/` },
];

const { title, description } = Astro.props;
---

<BaseLayout
  title={`${title} — COMP1720`}
  description={description}
  name="COMP1720"
  links={links}
>
  <slot />
</BaseLayout>
