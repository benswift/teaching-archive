---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Card from "astro-theme-anu/components/Card.astro";
import CardGrid from "astro-theme-anu/components/CardGrid.astro";

const assessments = await getCollection("assessments");
const visible = assessments
  .filter((a) => !a.data.hidden)
  .sort((a, b) => a.id.localeCompare(b.id));
---

<SiteLayout title="Assessments">
  <h1>Assessments</h1>
  <p class="lead">Assignments and project information.</p>

  <CardGrid columns={2}>
    {
      visible.map((item) => (
        <Card title={item.data.title} href={`${import.meta.env.BASE_URL}assessments/${item.id}/`}>
          {item.data.summary && <p>{item.data.summary}</p>}
        </Card>
      ))
    }
  </CardGrid>
</SiteLayout>
