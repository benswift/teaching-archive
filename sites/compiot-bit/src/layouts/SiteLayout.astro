---
import BaseLayout from "astro-theme-anu/layouts/BaseLayout.astro";

interface Props {
  title: string;
  description?: string;
}

const links = [
  { text: "Blog", href: `${import.meta.env.BASE_URL}blog/` },
  { text: "Deliverables", href: `${import.meta.env.BASE_URL}deliverables/` },
  { text: "Resources", href: `${import.meta.env.BASE_URL}resources/` },
];

const { title, description } = Astro.props;
---

<BaseLayout
  title={`${title} — IoT@BIT`}
  description={description}
  name="IoT@BIT"
  links={links}
>
  <slot />
</BaseLayout>
