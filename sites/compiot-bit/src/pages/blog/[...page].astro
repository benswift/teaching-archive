---
import type { GetStaticPathsOptions } from "astro";
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Card from "astro-theme-anu/components/Card.astro";
import CardGrid from "astro-theme-anu/components/CardGrid.astro";
import Pagination from "astro-theme-anu/components/Pagination.astro";

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getCollection("posts");
  const sorted = posts.sort(
    (a, b) => b.data.date.getTime() - a.data.date.getTime(),
  );
  return paginate(sorted, { pageSize: 12 });
}

const { page } = Astro.props;
---

<SiteLayout title="Blog">
  <h1>Blog</h1>
  <p class="lead">Design blog posts from the IoT@BIT 2018 cohort.</p>

  <CardGrid columns={2}>
    {
      page.data.map((post: any) => (
        <Card title={post.data.title} href={`${import.meta.env.BASE_URL}blog/${post.id}/`}>
          {post.data.author && (
            <p>
              <small>
                {post.data.author} &middot;{" "}
                {post.data.date.toLocaleDateString("en-AU", {
                  year: "numeric",
                  month: "short",
                  day: "numeric",
                })}
              </small>
            </p>
          )}
        </Card>
      ))
    }
  </CardGrid>

  <Pagination page={page} />
</SiteLayout>
