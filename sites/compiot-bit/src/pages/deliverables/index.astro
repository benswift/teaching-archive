---
import { getCollection } from "astro:content";
import SiteLayout from "../../layouts/SiteLayout.astro";
import Card from "astro-theme-anu/components/Card.astro";
import CardGrid from "astro-theme-anu/components/CardGrid.astro";

const deliverables = await getCollection("deliverables");
const visible = deliverables
  .filter((d) => !d.data.hidden)
  .sort((a, b) => a.id.localeCompare(b.id));
---

<SiteLayout title="Deliverables">
  <h1>Deliverables</h1>
  <p class="lead">Course assignments and assessment details.</p>

  <CardGrid columns={2}>
    {
      visible.map((item) => (
        <Card title={item.data.title} href={`${import.meta.env.BASE_URL}deliverables/${item.id}/`}>
          {item.data.summary && <p>{item.data.summary}</p>}
        </Card>
      ))
    }
  </CardGrid>
</SiteLayout>
